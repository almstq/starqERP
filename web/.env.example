# starqERP Web Client Environment Variables
# Copy to .env.local and provide the values for your deployment.
VITE_GOOGLE_CLIENT_ID=
# Set this for the local Vite /api proxy when using Supabase Edge Functions.
VITE_SUPABASE_URL=
# Optional direct API base URL. Leave unset to use the same-origin /api route.
VITE_API_URL=
