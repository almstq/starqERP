# starqERP E2E lab mode (SERP-328). Offline, deterministic, no production traffic.
# Requests stay same-origin on the Vite dev server (port 3001); Playwright route
# fixtures fulfill every /api/* call in-browser, so the real gateway is never hit.
VITE_SUPABASE_URL="http://localhost:3001"
VITE_API_URL="http://localhost:3001"
VITE_GOOGLE_CLIENT_ID="e2e-client-id-inert"