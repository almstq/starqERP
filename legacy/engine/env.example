# Copy to D:\StarqTech\_secrets\starqBooks.env  (outside this folder is fine; never commit)
# RULE 0: nothing installed or cached to C:. This file is data, not an installer.
# Work only under D:\StarqTech. Do not use D:\!starq.

# Google Cloud OAuth 2.0 Web client — founder supplies. Not in git.
STARQBOOKS_GOOGLE_CLIENT_ID=
# Optional. Second GIS audience (Android OAuth client). Same rules: env only, never source.
# STARQBOOKS_GOOGLE_ANDROID_CLIENT_ID=
# Only needed if Antigravity uses authorization-code instead of GIS ID tokens.
STARQBOOKS_GOOGLE_CLIENT_SECRET=

# Random 32+ bytes. python -c "import secrets; print(secrets.token_urlsafe(48))"
STARQBOOKS_SESSION_SECRET=

# Optional override. Default: D:\StarqTech\_secrets\starqBooks-allowlist.json
# STARQBOOKS_ALLOWLIST_PATH=D:\StarqTech\_secrets\starqBooks-allowlist.json
